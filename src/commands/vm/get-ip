#!/usr/bin/env bash

set -euo pipefail

# @description Print the non-loopback IPv4 address of a virtual machine.
# @usage str vm get-ip <vm-name>

usage() {
  echo "Usage: get-ip <vm-name>" >&2
}

require_virsh() {
  if ! command -v virsh >/dev/null 2>&1; then
    echo "vm: virsh is not installed" >&2
    exit 127
  fi
}

get_ip() {
  if [[ $# -ne 1 ]]; then
    usage
    exit 2
  fi

  local vm_name="$1"
  local interface_output
  local ip_address

  require_virsh

  if ! interface_output="$(
    virsh --connect qemu:///system domifaddr "$vm_name" --source agent 2>/dev/null
  )"; then
    echo "vm: failed to get IP address for: $vm_name" >&2
    exit 1
  fi

  ip_address="$(
    awk '$3 == "ipv4" && $4 !~ /^127\./ {
      sub(/\/.*/, "", $4)
      print $4
      exit
    }' \
      <<<"$interface_output"
  )"

  if [[ -z "$ip_address" ]]; then
    echo "vm: no non-loopback IPv4 address found for: $vm_name" >&2
    exit 1
  fi

  printf '%s\n' "$ip_address"
}

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

subcommand="$1"
shift

case "$subcommand" in
  get-ip)
    get_ip "$@"
    ;;
  *)
    echo "vm: unknown command: $subcommand" >&2
    usage
    exit 2
    ;;
esac
