#!/usr/bin/env bash
set -euo pipefail

# @description Stop a VM's user service and then stop the virtual machine.
# @usage str vm stop [--force] <vm-name>
# @option --force     Power off the VM immediately.
# @option -h, --help  Show help.

usage() {
  echo "Usage: $0 [--force] <vm-name>"
  echo
  echo "Options:"
  echo "  --force     Power off the VM immediately."
  echo "  -h, --help  Show this help."
}

force=false
vm_name=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force)
      force=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      usage >&2
      exit 2
      ;;
    *)
      if [[ -n "$vm_name" ]]; then
        usage >&2
        exit 2
      fi

      vm_name="$1"
      shift
      ;;
  esac
done

if [[ -z "$vm_name" ]]; then
  usage >&2
  exit 2
fi

if ! command -v systemctl >/dev/null 2>&1; then
  echo "vm: systemctl is not installed" >&2
  exit 127
fi

if systemctl --user cat "$vm_name.service" >/dev/null 2>&1; then
  systemctl --user stop "$vm_name.service"
fi

if ! command -v virsh >/dev/null 2>&1; then
  echo "vm: virsh is not installed" >&2
  exit 127
fi

if [[ "$force" == true ]]; then
  virsh --connect qemu:///system destroy "$vm_name"
else
  virsh --connect qemu:///system shutdown "$vm_name"
fi
