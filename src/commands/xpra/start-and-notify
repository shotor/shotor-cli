#!/usr/bin/env bash
set -euo pipefail

# @description Start an Xpra VM session and notify systemd when ready.
# @usage str xpra start-and-notify [--timeout <seconds>] <vm-name>
# @option --timeout <seconds>  Readiness timeout; defaults to 60 seconds.
# @option -h, --help           Show help.

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
timeout_seconds=60
vm_name=""

usage() {
  echo "Usage: $0 [--timeout <seconds>] <vm-name>"
  echo
  echo "Options:"
  echo "  --timeout <seconds>  Readiness timeout; defaults to 60 seconds."
  echo "  -h, --help           Show this help."
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --timeout)
      if [[ $# -lt 2 || ! "$2" =~ ^[1-9][0-9]*$ ]]; then
        usage >&2
        exit 2
      fi

      timeout_seconds="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      usage >&2
      exit 2
      ;;
    *)
      if [[ -n "$vm_name" ]]; then
        usage >&2
        exit 2
      fi

      vm_name="$1"
      shift
      ;;
  esac
done

if [[ -z "$vm_name" ]]; then
  usage >&2
  exit 2
fi

main_pid=$$
(
  deadline=$((SECONDS + timeout_seconds))

  until "$script_dir/is-running" "$vm_name"; do
    if (( SECONDS >= deadline )); then
      echo "start-and-notify: timed out after $timeout_seconds seconds" >&2
      kill "$main_pid" 2>/dev/null || true
      exit 1
    fi

    sleep 1
  done

  systemd-notify --ready
) &

exec "$script_dir/start" "$vm_name"
