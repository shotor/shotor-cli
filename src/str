#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
COMMANDS_DIR="$SCRIPT_DIR/str-commands"

list_commands() {
  local commands_dir="$1"
  local command_dir
  local command_entry
  local command_name
  local found_command=false

  echo "Available commands:"

  shopt -s globstar nullglob

  for command_dir in "$commands_dir"/*; do
    command_name="${command_dir##*/}"

    if [[ -f "$command_dir" && -x "$command_dir" ]]; then
      printf '  %s\n' "$command_name"
      found_command=true
      continue
    fi

    for command_entry in "$command_dir"/**; do
      if [[ -f "$command_entry" && -x "$command_entry" ]]; then
        printf '  %s\n' "$command_name"
        found_command=true
        break
      fi
    done
  done

  if [[ "$found_command" == false ]]; then
    echo "  (none)"
  fi
}

run_command() {
  local -a arguments=("$@")
  local argument
  local candidate_path="$COMMANDS_DIR"
  local command_dir
  local command_name="${arguments[0]}"
  local depth
  local index
  local leaf_name="${arguments[${#arguments[@]} - 1]}"

  for argument in "${arguments[@]}"; do
    if [[ -z "$argument" || "$argument" == "." || "$argument" == ".." || "$argument" == */* ]]; then
      echo "str: invalid command segment: $argument" >&2
      exit 2
    fi

    candidate_path+="/$argument"
  done

  if [[ -f "$candidate_path" && -x "$candidate_path" ]]; then
    exec "$candidate_path"
  fi

  command_dir="$candidate_path"
  candidate_path+="/$leaf_name"

  if [[ -f "$candidate_path" && -x "$candidate_path" ]]; then
    exec "$candidate_path"
  fi

  if [[ -d "$command_dir" ]]; then
    list_commands "$command_dir"
    exit 0
  fi

  for ((depth = ${#arguments[@]} - 1; depth >= 2; depth--)); do
    command_dir="$COMMANDS_DIR"

    for ((index = 0; index < depth; index++)); do
      command_dir+="/${arguments[index]}"
    done

    if [[ -f "$command_dir" && -x "$command_dir" ]]; then
      exec "$command_dir" "${arguments[@]:depth}"
    fi

    candidate_path="$command_dir/${arguments[depth - 1]}"

    if [[ -f "$candidate_path" && -x "$candidate_path" ]]; then
      exec "$candidate_path" "${arguments[@]:depth}"
    fi
  done

  command_dir="$COMMANDS_DIR/$command_name"
  candidate_path="$command_dir/$command_name"

  if [[ -f "$candidate_path" && -x "$candidate_path" ]]; then
    exec "$candidate_path" "${arguments[@]:1}"
  fi

  candidate_path="$COMMANDS_DIR/$command_name"

  if [[ -f "$candidate_path" && -x "$candidate_path" ]]; then
    exec "$candidate_path" "${arguments[@]:1}"
  fi

  echo "str: command not found: ${arguments[*]}" >&2
  exit 127
}

if [[ $# -eq 0 ]]; then
  list_commands "$COMMANDS_DIR"
  exit 0
fi

run_command "$@"
