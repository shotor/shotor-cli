#!/usr/bin/env bash
set -euo pipefail

# >>> SHOTOR_BUNDLE_LIB
# In a dev checkout the library files are sourced from ./lib. When building a
# standalone executable scripts/build.sh replaces everything between these
# markers (inclusive) with the inlined library contents.
__shotor_lib_dir="$(cd -- "$(dirname -- "$(
  path="${BASH_SOURCE[0]}"
  while [[ -L "$path" ]]; do
    dir="$(cd -- "$(dirname -- "$path")" && pwd)"
    path="$(readlink -- "$path")"
    [[ "$path" != /* ]] && path="$dir/$path"
  done
  printf '%s\n' "$path"
)")" && pwd)/lib"

# shellcheck disable=SC1091
source "$__shotor_lib_dir/scripts-dir.sh"
# shellcheck disable=SC1091
source "$__shotor_lib_dir/discovery.sh"
# shellcheck disable=SC1091
source "$__shotor_lib_dir/dispatch.sh"
# shellcheck disable=SC1091
source "$__shotor_lib_dir/completions.sh"
# <<< SHOTOR_BUNDLE_LIB

dispatcher_name="$(basename -- "$0")"

if [[ "${1:-}" == "--install-completions" ]]; then
  shotor_install_completions "$dispatcher_name"
  exit $?
fi

scripts_dir="$(shotor_scripts_dir "${BASH_SOURCE[0]}")"

if [[ $# -eq 0 ]]; then
  list_commands "$scripts_dir" "$scripts_dir"
  exit 0
fi

run_command "$dispatcher_name" "$scripts_dir" "$@"
