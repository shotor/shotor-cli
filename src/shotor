#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
COMMANDS_DIR="$SCRIPT_DIR/commands"

list_commands() {
  local command_dir
  local command_name
  local found_command=false

  echo "Available commands:"

  shopt -s nullglob

  for command_dir in "$COMMANDS_DIR"/*; do
    command_name="$(basename -- "$command_dir")"

    if [[ -d "$command_dir" && -x "$command_dir/$command_name" ]]; then
      printf '  %s\n' "$command_name"
      found_command=true
    fi
  done

  if [[ "$found_command" == false ]]; then
    echo "  (none)"
  fi
}

if [[ $# -eq 0 ]]; then
  list_commands
  exit 0
fi

command_name="$1"
shift

command_dir="$COMMANDS_DIR/$command_name"
command_path="$command_dir/$command_name"

if [[ ! -d "$command_dir" ]]; then
  echo "shotor: command not found: $command_name" >&2
  exit 127
fi

if [[ ! -f "$command_path" ]]; then
  echo "shotor: command entrypoint not found: $command_path" >&2
  exit 127
fi

if [[ ! -x "$command_path" ]]; then
  echo "shotor: command is not executable: $command_path" >&2
  exit 126
fi

exec "$command_path" "$@"
